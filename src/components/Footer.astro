---
---

<footer class="border-t border-white/10 bg-[#0A0A0B]">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
          Colombo · Sri Lanka
        </p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight text-[#F5F5F3] sm:text-6xl">
          Let’s build your next digital flagship.
        </h2>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-open-inquiry
            data-cursor-label="Inquire"
            class="bg-[#F5F5F3] px-7 py-3.5 text-xs font-semibold tracking-[0.18em] text-[#0A0A0B] uppercase transition hover:bg-white"
          >
            Start a Project
          </button>
          <a
            href="mailto:info@october.lk"
            class="border border-white/20 px-6 py-3.5 text-xs font-medium tracking-[0.16em] text-neutral-200 uppercase transition hover:border-white"
          >
            Email Us
          </a>
          <a
            href="tel:+94778892555"
            class="border border-white/20 px-6 py-3.5 text-xs font-medium tracking-[0.16em] text-neutral-200 uppercase transition hover:border-white"
          >
            Call Us
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 text-xs lg:col-span-5 lg:pl-12">
        <div>
          <p class="text-[10px] font-semibold tracking-[0.2em] text-neutral-500 uppercase">
            Navigation
          </p>
          <ul class="mt-4 space-y-3 tracking-[0.14em] text-neutral-300 uppercase">
            <li><a href="/" class="hover:text-white">Home</a></li>
            <li><a href="/work/" class="hover:text-white">Work</a></li>
            <li><a href="/services/" class="hover:text-white">Services</a></li>
            <li>
              <button type="button" data-open-inquiry class="uppercase hover:text-white">
                Contact
              </button>
            </li>
          </ul>
        </div>
        <div>
          <p class="text-[10px] font-semibold tracking-[0.2em] text-neutral-500 uppercase">
            Direct
          </p>
          <ul class="mt-4 space-y-3 text-neutral-300">
            <li>
              <a href="mailto:info@october.lk" class="hover:text-white">info@october.lk</a>
            </li>
            <li>
              <a href="tel:+94778892555" class="hover:text-white">+94 77 889 2555</a>
            </li>
            <li>
              <a
                href="https://www.instagram.com/october.lk/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-white"
              >
                Instagram ↗
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-20 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 text-[11px] tracking-[0.2em] text-neutral-500 uppercase sm:flex-row sm:items-center"
    >
      <span>OCTOBER INC. 2026</span>
      <span>DIGITAL DESIGN &amp; TECHNICAL SERVICES</span>
    </div>
  </div>
</footer>
