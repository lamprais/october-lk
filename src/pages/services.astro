---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const renderedServices = await Promise.all(
  services.map(async (entry) => ({
    entry,
    rendered: await render(entry),
  }))
);
---

<Layout
  title="Services – October Digital Agency"
  description="Brand identity, Astro & Next.js web engineering, booking engine integrations, Technical SEO/GEO, and hospitality data pipelines."
  canonicalPath="/services/"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Digital Design & Technical Services',
    provider: {
      '@type': 'ProfessionalService',
      name: 'October Digital Agency',
      url: 'https://october.lk',
    },
    areaServed: 'LK',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Agency Capabilities',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: s.data.title,
          description: s.data.summary,
        },
      })),
    },
  }}
>
  <main class="mx-auto max-w-7xl px-6 py-20 sm:py-28">
    <div class="border-b border-white/10 pb-16">
      <p class="text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
        Capabilities
      </p>
      <h1
        class="split-reveal mt-4 max-w-4xl text-4xl font-bold tracking-tight text-[#F5F5F3] uppercase sm:text-7xl"
        data-reveal-immediate="true"
      >
        Build Brand Identity &amp; Digital Infrastructure.
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-neutral-400">
        We bridge editorial brand design with edge-deployed web engineering, booking systems, and operational data pipelines.
      </p>
    </div>

    <div class="divide-y divide-white/10">
      {
        renderedServices.map(({ entry, rendered }) => {
          const { Content } = rendered;
          return (
            <section class="grid grid-cols-1 gap-10 py-16 lg:grid-cols-12">
              <div class="lg:col-span-5">
                <span class="text-xs font-semibold tracking-[0.2em] text-[var(--ambient-accent)]">
                  {entry.data.code} — {entry.data.tagline}
                </span>
                <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[#F5F5F3]">
                  {entry.data.title}
                </h2>
                <div class="mt-5 flex flex-wrap gap-2">
                  {entry.data.stack.map((tech) => (
                    <span class="border border-white/15 px-3 py-1 text-[10px] tracking-[0.12em] text-neutral-300 uppercase">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="space-y-6 lg:col-span-7">
                <p class="text-lg leading-relaxed text-neutral-200">{entry.data.summary}</p>
                <div class="text-sm leading-relaxed text-neutral-400">
                  <Content />
                </div>
                <div class="border-t border-white/10 pt-6">
                  <p class="text-[10px] font-semibold tracking-[0.2em] text-neutral-500 uppercase">
                    Key Deliverables
                  </p>
                  <ul class="mt-4 grid grid-cols-1 gap-3 text-sm text-neutral-300 sm:grid-cols-2">
                    {entry.data.deliverables.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--ambient-accent)]" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>
          );
        })
      }
    </div>
  </main>
</Layout>
